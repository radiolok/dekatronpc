  cell(LATCH) {
    area: 3.5;
    current_unit : "1mA";
    heat_current: 1000;
    tubes(names) {
      N16B: 1.5;
      J2B: 2;
    }
    latch(IQ, IQN) { enable: C;
                  data_in: D; }
    pin(C) { direction: input; fanout_load: 1.0;
                 clock: true; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(Q) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQ"; }
    pin(QN) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQN"; }
  }
  cell(DFF) {
    area: 7;
    current_unit : "1mA";
    heat_current: 2000;
    tubes(names) {
      N16B: 3;
      J2B: 4;
    }
    ff(IQ, IQN) { clocked_on: C;
                  next_state: D; }
    pin(C) { direction: input; fanout_load: 1.0;
                 clock: true; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(Q) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQ"; }
    pin(QN) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQN"; }
  }
  cell(DFFSR) {
    area: 7;
    current_unit : "1mA";
    heat_current: 2000;
    ff(IQ, IQN) {
    next_state : "D" ;
    clocked_on : "C" ;
    clear : "R" ;
    preset : "S" ;
    }
    tubes(names) {
      N16B: 3;
      J2B: 4;
    }
    pin(C) { direction: input;
                 clock: true; }
    pin(D) { direction: input; }
    pin(Q) { direction: output;
              function: "IQ"; }
    pin(QN) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQN"; }
    pin(S) { direction: input; }
    pin(R) { direction: input; }
  }

  cell(DFFSR_n) {
    area: 7;
    current_unit : "1mA";
    heat_current: 2000;
    ff(IQ, IQN) {
    next_state : "D" ;
    clocked_on : "C" ;
    clear : "R'" ;
    preset : "S" ;
    }
    tubes(names) {
      N16B: 3;
      J2B: 4;
    }
    pin(C) { direction: input;
                 clock: true; }
    pin(D) { direction: input; }
    pin(Q) { direction: output;
              function: "IQ"; }
    pin(QN) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQN"; }
    pin(S) { direction: input; }
    pin(R) { direction: input; }
  }
  // Relay with two changeover contacts (2CO, 2 poles). Not a tube: area 0,
  // no filament. The output pins have no function on purpose, so ABC never
  // uses the relay in random logic: it only appears where RTL instantiates it
  // (RelayMux/RelayEn, rtl/Logic/Relay.sv). COIL is driven only by a panel
  // switch (static); the contacts pass any signal. Cn = COIL ? NOn : NCn.
  cell(RELAY_2CO) {
    area: 0;
    current_unit : "1mA";
    heat_current: 0;
    tubes(names) {
      N16B: 0;
    }
    relays(names) {
      RELAY_2CO: 1;
    }
    pin(COIL) { direction: input; }
    pin(NC1) { direction: input; }
    pin(NO1) { direction: input; }
    pin(NC2) { direction: input; }
    pin(NO2) { direction: input; }
    pin(C1) { direction: output; }
    pin(C2) { direction: output; }
  }
    cell (TIEHI) {
    area : 0.0;
    tubes(names) {
      N16B: 0;
    }
    pin (H) {
      direction : output;
      driver_type : open_drain;
      function : "1";
    }
  }
  cell (TIELO) {
    area : 0.0;
    tubes(names) {
      N16B: 0;
    }
    pin (L) {
      direction : output;
      driver_type : open_source;
      function : "0";
    }
  }
}
