library(vtube_cells_lib) {
  cell(BUF_N16) {
    area: 0.5;
    tubes(names) {
      N16B: 0.5;
    }
    current_unit : "1mA";
    heat_current: 200;
    pin(A) { direction: input; fanout_load: 1.0;}
    pin(Y) { direction: output;
              driver_type : pull_up;
               max_fanout : 10;
              function: "A"; }
  }
