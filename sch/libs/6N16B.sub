*--------------------------------------------------------------------------
* 6N16B (6Н16Б) dual triode, Koren model, ngspice syntax
*
*    Type           : 6N16B
*    Description    : Dual triode, indirectly heated, common heater
*    Pins           : Pa Ga Ka Pb Gb Kb (heater is not modelled)
*
* KiCad symbol vacuum_tube:6Н16Б: unit A = A1 G7 K6, unit B = A5 G3 K2,
* heater 4/8 left unmapped:  Sim.Pins "1=Pa 7=Ga 6=Ka 5=Pb 3=Gb 2=Kb"
*
* Koren parameters as before (MU=25.96 EX=1.79 KG1=557.56 KP=137.33
* KVB=391.918). Plate current (PWR(x)+PWRS(x))/2 of the PSpice original is
* max(x,0)^EX here: ngspice has no PWRS. The second grid-current branch
* was wired to Ga in the old file; it is on Gb now.
*--------------------------------------------------------------------------
.SUBCKT 6N16B Pa Ga Ka Pb Gb Kb
+ PARAMS: CCG=2.7P CGP=1.5P CCP=1.65P RGI=2000
+ MU=25.96 EX=1.79 KG1=557.56 KP=137.33 KVB=391.918
* triode A
E1  7  0  VALUE={V(Pa,Ka)/KP*LOG(1+EXP(KP*(1/MU+V(Ga,Ka)/SQRT(KVB+V(Pa,Ka)*V(Pa,Ka)))))}
RE1 7  0  1G
G1  Pa Ka VALUE={PWR(MAX(V(7),0),EX)/KG1}
RCP1 Pa Ka 1G
C1  Ga Ka {CCG}  ; cathode-grid
C2  Ga Pa {CGP}  ; grid-plate
C3  Pa Ka {CCP}  ; cathode-plate
R1  Ga 5  {RGI}  ; grid current
D1  5  Ka DX
* triode B
E2  17 0  VALUE={V(Pb,Kb)/KP*LOG(1+EXP(KP*(1/MU+V(Gb,Kb)/SQRT(KVB+V(Pb,Kb)*V(Pb,Kb)))))}
RE2 17 0  1G
G2  Pb Kb VALUE={PWR(MAX(V(17),0),EX)/KG1}
RCP2 Pb Kb 1G
C4  Gb Kb {CCG}  ; cathode-grid
C5  Gb Pb {CGP}  ; grid-plate
C6  Pb Kb {CCP}  ; cathode-plate
R2  Gb 15 {RGI}  ; grid current
D2  15 Kb DX
.MODEL DX D(IS=1N RS=1 CJO=10PF TT=1N)
.ENDS 6N16B
