(text ".meas tran VOH    FIND v(/OUT) AT=1.95u\n.meas tran VOL_A  FIND v(/OUT) AT=3.95u\n.meas tran VOL_B  FIND v(/OUT) AT=5.95u\n.meas tran VOL_AB FIND v(/OUT) AT=7.95u\n.meas tran LV_HI  FIND v(/OUT_LV) AT=1.95u\n.meas tran LV_LO  FIND v(/OUT_LV) AT=3.95u\n.meas tran GMIN   MIN v(/IN_A) FROM=0.5u TO=10u\n.meas tran LVMIN  MIN v(/OUT_LV) FROM=0.5u TO=10u\n.meas tran TPHL TRIG v(/IN_A) VAL=-5 RISE=1 TARG v(/OUT) VAL=100 FALL=1\n.meas tran TPLH TRIG v(/IN_A) VAL=-5 FALL=1 TD=7.9u TARG v(/OUT) VAL=100 RISE=1 TD=7.9u" (exclude_from_sim no) (at 50.8 165.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "88706333-af27-44a1-ad46-84861cd136fc"))
(text "NOR2_N16 testbench. 2 us per input state, DUT (A,B) = 00 10 01 11 00.\nSTIM_x (HV, ideal) -> divider -> driver gate -> divider -> IN_x (LV): real edges and levels on the DUT grids.\nOUT (HV) -> one divider (C1 = 3.9 pF x 10 grids) -> OUT_LV -> 5 load gates, inputs tied = fanout 10.\nPlot V(/IN_A) V(/IN_B) V(/OUT) V(/OUT_LV); .meas results are printed in the simulator console." (exclude_from_sim no) (at 50.8 203.2 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "834277df-5b7e-4a9a-832a-7c972338840c"))
