library(vtube_cells_lib) {
  // Signal levels (REQ-MOD-012, doc/hv_lv_dividers.md). Read by rtl/run/div_insert.py, ignored by ABC.
  //   vtube_level (pin): "HV" plate output (+150/+50 V), "LV" grid-level output (cathode follower)
  //     or the LV side of DIV_HL, "PASS" relay contact (carries the level of what drives it),
  //     "COIL" relay coil (panel switch only), "CONST" tie cell. Default: output "HV", input a grid.
  //   vtube_grid (input pin): "triode", "pentode_g1", "pentode_g3", "follower" (a cathode follower grid:
  //     needs its own divider). Default "triode".
  //   vtube_c1 (input pin): divider speed-up capacitance per grid, pF. Default 3.9.
  define(vtube_level, pin, string);
  define(vtube_grid, pin, string);
  define(vtube_c1, pin, float);
  cell(BUF_N16) {
    area: 0.5;
    tubes(names) {
      N16B: 0.5;
    }
    current_unit : "1mA";
    heat_current: 200;
    pin(A) { vtube_grid : "follower"; vtube_c1 : 2.7; direction: input; fanout_load: 1.0;}
    pin(Y) { vtube_level : "LV"; direction: output;
              driver_type : pull_up;
               max_fanout : 10;
              function: "A"; }
  }
  cell(BUF_6J2B) {
    area: 1;
    current_unit : "1mA";
    heat_current: 200;
    tubes(names) {
      J2B: 1;
    }
    pin(A) { direction: input; fanout_load: 1.0;}
    pin(Y) { direction: output;
              driver_type : pull_up;
               max_fanout : 10;
              function: "A"; }
  }
  cell(NOT_N16) {
    area: 0.5;
    current_unit : "1mA";
    heat_current: 200;
    tubes(names) {
      N16B: 0.5;
    }
    pin(A) { vtube_grid : "triode"; vtube_c1 : 3.9; direction: input; fanout_load: 1.0; }
    pin(Y) { vtube_level : "HV"; direction: output;
              driver_type : pull_up;
               max_fanout : 10;
              function: "A'"; }
  }
  cell(NOT_J2) {
    area: 1;
    current_unit : "1mA";
    heat_current: 200;
    tubes(names) {
      J2B: 1;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
              driver_type : pull_up;
               max_fanout : 10;
              function: "A'"; }
  }
  cell(NAND2_N16X7) {
    area: 1.5;
    current_unit : "1mA";
    heat_current: 500;
    tubes(names) {
      N16B: 0.5;
      X7B: 1;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
             driver_type : pull_up;
               max_fanout : 10;
             function: "(A*B)'"; }
  }
  cell(AND2_N16X7) {
    area: 1.5;
    current_unit : "1mA";
    heat_current: 500;
    tubes(names) {
      N16B: 0.5;
      X7B: 1;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
            driver_type : pull_up;
               max_fanout : 10;
             function: "(A*B)"; }

  }
  cell(NAND2_J2) {
    area: 1;
    current_unit : "1mA";
    heat_current: 200;
    tubes(names) {
      J2B: 1;
    }
    pin(A) { vtube_grid : "pentode_g1"; vtube_c1 : 3.9; direction: input; fanout_load: 1.0; }
    pin(B) { vtube_grid : "pentode_g3"; vtube_c1 : 6.8; direction: input; fanout_load: 1.0; }
    pin(Y) { vtube_level : "HV"; direction: output;
            driver_type : pull_up;
               max_fanout : 10;
             function: "(A*B)'"; }

  }
  cell(NAND4_N16X7) {
    area: 2.5;
    current_unit : "1mA";
    heat_current: 800;
    tubes(names) {
      N16B: 0.5;
      X7B: 2;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(C) { direction: input; fanout_load: 1.0; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
             function: "(A*B*C*D)'"; }
  }
  cell(A1OOI_N16J2){
    area: 2;
    current_unit : "1mA";
    heat_current: 550;
    tubes(names) {
      J2: 1;
      N16B: 1;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(C) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
            driver_type : pull_up;
               max_fanout : 10;
             function: "((A*B)+C)'"; }
  }
  cell(A2OOI_J2){
    area: 2;
    current_unit : "1mA";
    heat_current: 400;
    tubes(names) {
      J2: 2;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(C) { direction: input; fanout_load: 1.0; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
            driver_type : pull_up;
               max_fanout : 10;
             function: "((A*B)+C+D)'"; }
  }
  cell(OR2_N16) {
    area: 1;
    current_unit : "1mA";
    heat_current: 400;
    tubes(names) {
      N16B: 1;
    }
    pin(A) { vtube_grid : "follower"; vtube_c1 : 2.7; direction: input; fanout_load: 1.0; }
    pin(B) { vtube_grid : "follower"; vtube_c1 : 2.7; direction: input; fanout_load: 1.0; }
    pin(Y) { vtube_level : "LV"; direction: output;
               max_fanout : 10;
            driver_type : pull_up;
             function: "(A+B)"; }
  }
  cell(OR2_N16X7) {
    area: 1.5;
    current_unit : "1mA";
    heat_current: 500;
    tubes(names) {
      N16B: 0.5;
      X7B: 1;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
             function: "(A+B)"; }
  }
  cell(OR4_N16X7) {
    area: 2.5;
    current_unit : "1mA";
    heat_current: 800;
    tubes(names) {
      N16B: 0.5;
      X7B: 2;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(C) { direction: input; fanout_load: 1.0; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
             function: "(A+B+C+D)"; }
  }
  cell(OR10_X7) {
    area: 5;
    current_unit : "1mA";
    heat_current: 800;
    tubes(names) {
      X7B: 5;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(C) { direction: input; fanout_load: 1.0; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(E) { direction: input; fanout_load: 1.0; }
    pin(F) { direction: input; fanout_load: 1.0; }
    pin(G) { direction: input; fanout_load: 1.0; }
    pin(H) { direction: input; fanout_load: 1.0; }
    pin(K) { direction: input; fanout_load: 1.0; }
    pin(L) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
               max_fanout : 1;
            driver_type : pull_up;
             function: "(A+B+C+D+E+F+G+H+K+L)"; }
  }
  cell(NOR2_N16) {
    area: 1;
    current_unit : "1mA";
    heat_current: 400;
    tubes(names) {
      N16B: 1;
    }
    pin(A) { vtube_grid : "triode"; vtube_c1 : 3.9; direction: input; fanout_load: 1.0; }
    pin(B) { vtube_grid : "triode"; vtube_c1 : 3.9; direction: input; fanout_load: 1.0; }
    pin(Y) { vtube_level : "HV"; direction: output;
               max_fanout : 10;
            driver_type : pull_up;
             function: "(A+B)'"; }
  }
  cell(NOR4_N16) {
    area: 2;
    current_unit : "1mA";
    heat_current: 800;
    tubes(names) {
      N16B: 2;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(C) { direction: input; fanout_load: 1.0; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
             function: "(A+B+C+D)'"; }
  }
  cell(NOR2_N16X7) {
    area: 1.5;
    current_unit : "1mA";
    heat_current: 500;
    tubes(names) {
      N16B: 0.5;
      X7B: 1;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
             function: "(A+B)'"; }
  }
  cell(NOR4_N16X7) {
    area: 2.5;
    current_unit : "1mA";
    heat_current: 800;
    tubes(names) {
      N16B: 0.5;
      X7B: 2;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(C) { direction: input; fanout_load: 1.0; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
             function: "(A+B+C+D)'"; }
  }
    cell(NOR10_N16X7) {
    area: 5.5;
    current_unit : "1mA";
    heat_current: 800;
    tubes(names) {
      X7B: 5;
    }
    pin(A) { direction: input; fanout_load: 1.0; }
    pin(B) { direction: input; fanout_load: 1.0; }
    pin(C) { direction: input; fanout_load: 1.0; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(E) { direction: input; fanout_load: 1.0; }
    pin(F) { direction: input; fanout_load: 1.0; }
    pin(G) { direction: input; fanout_load: 1.0; }
    pin(H) { direction: input; fanout_load: 1.0; }
    pin(K) { direction: input; fanout_load: 1.0; }
    pin(L) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output;
               max_fanout : 5;
            driver_type : pull_up;
             function: "(A+B+C+D+E+F+G+H+K+L)'"; }
  }
  cell(LATCH) {
    area: 3.5;
    current_unit : "1mA";
    heat_current: 1000;
    tubes(names) {
      N16B: 1.5;
      J2B: 2;
    }
    latch(IQ, IQN) { enable: C;
                  data_in: D; }
    pin(C) { direction: input; fanout_load: 1.0;
                 clock: true; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(Q) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQ"; }
    pin(QN) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQN"; }
  }
  cell(DFF) {
    area: 7;
    current_unit : "1mA";
    heat_current: 2000;
    tubes(names) {
      N16B: 3;
      J2B: 4;
    }
    ff(IQ, IQN) { clocked_on: C;
                  next_state: D; }
    pin(C) { direction: input; fanout_load: 1.0;
                 clock: true; }
    pin(D) { direction: input; fanout_load: 1.0; }
    pin(Q) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQ"; }
    pin(QN) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQN"; }
  }
  cell(DFFSR) {
    area: 7;
    current_unit : "1mA";
    heat_current: 2000;
    ff(IQ, IQN) {
    next_state : "D" ;
    clocked_on : "C" ;
    clear : "R" ;
    preset : "S" ;
    }
    tubes(names) {
      N16B: 3;
      J2B: 4;
    }
    pin(C) { direction: input;
                 clock: true; }
    pin(D) { direction: input; }
    pin(Q) { direction: output;
              function: "IQ"; }
    pin(QN) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQN"; }
    pin(S) { direction: input; }
    pin(R) { direction: input; }
  }

  cell(DFFSR_n) {
    area: 7;
    current_unit : "1mA";
    heat_current: 2000;
    ff(IQ, IQN) {
    next_state : "D" ;
    clocked_on : "C" ;
    clear : "R'" ;
    preset : "S" ;
    }
    tubes(names) {
      N16B: 3;
      J2B: 4;
    }
    pin(C) { direction: input;
                 clock: true; }
    pin(D) { direction: input; }
    pin(Q) { direction: output;
              function: "IQ"; }
    pin(QN) { direction: output;
               max_fanout : 10;
            driver_type : pull_up;
              function: "IQN"; }
    pin(S) { direction: input; }
    pin(R) { direction: input; }
  }
  // Relay with two changeover contacts (2CO, 2 poles). Not a tube: area 0,
  // no filament. The output pins have no function on purpose, so ABC never
  // uses the relay in random logic: it only appears where RTL instantiates it
  // (RelayMux/RelayEn, rtl/Logic/Relay.sv). COIL is driven only by a panel
  // switch (static); the contacts pass any signal. Cn = COIL ? NOn : NCn.
  cell(RELAY_2CO) {
    area: 0;
    current_unit : "1mA";
    heat_current: 0;
    tubes(names) {
      N16B: 0;
    }
    relays(names) {
      RELAY_2CO: 1;
    }
    pin(COIL) { vtube_level : "COIL"; direction: input; }
    pin(NC1) { vtube_level : "PASS"; direction: input; }
    pin(NO1) { vtube_level : "PASS"; direction: input; }
    pin(NC2) { vtube_level : "PASS"; direction: input; }
    pin(NO2) { vtube_level : "PASS"; direction: input; }
    pin(C1) { vtube_level : "PASS"; direction: output; }
    pin(C2) { vtube_level : "PASS"; direction: output; }
  }
  // HV -> LV divider of one net (REQ-MOD-012): R1 470k || C1 from HV to LV, R2 200k from LV to -50 V.
  // No tube and no function, so ABC never uses it: rtl/run/div_insert.py places one per HV net and grid
  // class after mapping, with C1 (parameter C1_DPF, 0.1 pF) = sum of vtube_c1 over the grids it feeds.
  // P&R decides the board: the source side or the receiver side of a connector (doc/hv_lv_dividers.md).
  cell(DIV_HL) {
    area: 0;
    current_unit : "1mA";
    heat_current: 0;
    tubes(names) {
      N16B: 0;
    }
    pin(HV) { direction: input; vtube_level : "HV"; }
    pin(LV) { direction: output; vtube_level : "LV"; }
  }
  // Guide gate of a dekatron decade: one J2, a pentode with two control
  // grids, per guide (two per decade). The counter drives the guide buses
  // (DekatronPulseSender at counter level); the guide pulse G goes to one
  // grid, EN (the decade's carry) to the other: Y = G & EN. Like RELAY_2CO,
  // the output has no function on purpose: ABC never uses this cell in
  // random logic, it only appears where DekatronModule instantiates it.
  cell(GUIDE_EN_J2) {
    area: 1;
    current_unit : "1mA";
    heat_current: 200;
    tubes(names) {
      J2B: 1;
    }
    pin(EN) { direction: input; fanout_load: 1.0; }
    pin(G) { direction: input; fanout_load: 1.0; }
    pin(Y) { direction: output; }
  }
    cell (TIEHI) {
    area : 0.0;
    tubes(names) {
      N16B: 0;
    }
    pin (H) { vtube_level : "CONST";
      direction : output;
      driver_type : open_drain;
      function : "1";
    }
  }
  cell (TIELO) {
    area : 0.0;
    tubes(names) {
      N16B: 0;
    }
    pin (L) { vtube_level : "CONST";
      direction : output;
      driver_type : open_source;
      function : "0";
    }
  }
}
